<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="电视相册接收器"
                android:textColor="#F8FAFC"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#065F46"
                android:paddingLeft="18dp"
                android:paddingTop="8dp"
                android:paddingRight="18dp"
                android:paddingBottom="8dp"
                android:text="启动中..."
                android:textColor="#ECFDF5"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="手机打开「电视相册推送」即可自动搜到本电视，无需填 IP。收到的照片写入 Pictures/TVAlbums，原版 Aves 自动同步。"
            android:textColor="#94A3B8"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#111C33"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="电视名称：客厅电视"
                android:textColor="#F8FAFC"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已收相册：0 个 · 照片：0 张 · 可用空间：--"
                android:textColor="#CBD5E1"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/tvNetworkInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="局域网状态：正在获取 IP..."
                android:textColor="#94A3B8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLastEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="最新动态：等待手机推送"
                android:textColor="#38BDF8"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenAves"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:focusable="true"
                android:text="打开原版 Aves 播放"
                android:textColor="#F8FAFC"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRename"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:focusable="true"
                android:text="修改电视名称"
                android:textColor="#F8FAFC"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleAutoStart"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:background="@drawable/tv_button_bg"
                android:focusable="true"
                android:text="开机自启：已开启"
                android:textColor="#F8FAFC"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="提示：退回桌面或打开 Aves 播放幻灯片时，接收服务会继续在后台待命。建议在系统设置中将本应用设为「电池不优化」。"
            android:textColor="#64748B"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
